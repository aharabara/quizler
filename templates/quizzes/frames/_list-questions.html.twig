<div id="list-question">
    <div class="list-questions--filters d-flex justify-content-end mb-1">
        {% include 'quizzes/frames/_list-questions__filters.html.twig' %}
    </div>
    <ul class="list-group" style="overflow: scroll; height: calc(100vh - 15rem) ">
        {% for item in questions %}
            {%  include 'quizzes/frames/_list-questions__item.html.twig' with {
                active: currentQuestion.id == item.id,
                item: item
            } %}
        {% endfor %}
    </ul>
</div>

<style>
.htmx-swapping {
    animation: shaking 0.4s infinite;
}
.htmx-swapping input,
.htmx-swapping p,
.htmx-swapping textarea,
.htmx-swapping button,
.htmx-swapping
{
    background : rgba(0,0,0, 0.1)
}

@keyframes shaking {
 0% { background : rgba(0,0,0, 0.05) }
 /* 25% { transform: translateX(5px) } */
 50% { background : rgba(0,0,0, 0.07) }
 /* 75% { transform: translateX(5px) } */
 100% { background : rgba(0,0,0, 0.1) }
}
</style>
