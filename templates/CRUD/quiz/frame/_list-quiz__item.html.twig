<tr>
    <td>{{ item.value }}</td>
    <td>{{ item.answered }} / {{ item.total }}</td>
    <td class="action-column" hx-boost="true">
        <a href="{{ path('new_grind', {quiz : item.id}) }}" class="btn btn-success">
            <i class="ri-question-answer-fill"></i>
        </a>
        <a href="{{ path('quiz_edit', {quiz : item.id}) }}" class="btn btn-warning">
            <i class="ri-pencil-fill"></i>
        </a>
        <button hx-delete="{{ path('quiz_delete', {quiz : item.id}) }}" hx-target="body" class="btn btn-danger"
           hx-confirm="Are you sure you want to delete this quiz?"
        >
            <i class="ri-delete-bin-2-fill"></i>
        </button>
    </td>
</tr>
